[Unit]
Description=Bloch L2 mainnet (700770) shadow producer: independently rebuilds every block the settler produces and halts on any difference (no proving, no submission)
After=bloch-l2-mainnet-settler.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The settler user: read access to its work dir; the shadow writes only its own state dir.
User=bloch-l2-mainnet-settler
Group=bloch-l2-mainnet-settler
Environment=BLOCH_SEQUENCER_CONFIG=/etc/bloch-l2-mainnet-shadow/config.json
Environment=HOME=/var/lib/bloch-l2-mainnet-shadow
Environment=TMPDIR=/var/lib/bloch-l2-mainnet-shadow/tmp
ExecStartPre=/usr/bin/python3 -u /opt/bloch/l2-mainnet-shadow/sequencer_mainnet.py check
ExecStart=/usr/bin/python3 -u /opt/bloch/l2-mainnet-shadow/sequencer_mainnet.py run
Restart=on-failure
RestartSec=30
# Exit 3 = divergence (identity, parent, anchor, genesis): wait for an operator.
RestartPreventExitStatus=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/bloch-l2-mainnet-shadow
ReadOnlyPaths=/etc/bloch-l2-mainnet-shadow /opt/bloch/l2-mainnet-shadow /var/lib/bloch-l2-mainnet-settler/work
# The shadow runs as the settler user, which owns the DA fee key, its passphrase and the prover SSH key and is
# in the docker group (the Docker socket is root on this host; a read-only mount does not stop a socket
# connect). The shadow needs none of them.
InaccessiblePaths=-/run/docker.sock -/var/lib/bloch-l2-mainnet-da -/var/lib/bloch-l2-mainnet-settler/da.passphrase -/var/lib/bloch-l2-mainnet-settler/ssh
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Read-only getl2settlement on the three Genesis-4 mainnet nodes; nothing else.
IPAddressDeny=any
IPAddressAllow=localhost 80.240.16.185 199.247.22.8 45.77.67.251
LimitCORE=0
Nice=5
MemoryMax=4G
MemorySwapMax=0
CPUQuota=400%

[Install]
WantedBy=multi-user.target
