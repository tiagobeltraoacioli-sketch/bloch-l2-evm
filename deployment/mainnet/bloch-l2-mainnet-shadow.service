[Unit]
Description=Bloch L2 mainnet (700770) shadow producer: independently rebuilds every block the settler produces and halts on any difference (no proving, no submission)
After=bloch-l2-mainnet-settler.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Its own user (review r10 decision 4), in the settler's read group: it reads the settler's work directory and
# writes only its own state directory.
User=bloch-l2-mainnet-shadow
Group=bloch-l2-mainnet-shadow
SupplementaryGroups=bloch-l2-mainnet-l2read
Environment=BLOCH_SEQUENCER_CONFIG=/etc/bloch-l2-mainnet-shadow/config.json
Environment=HOME=/var/lib/bloch-l2-mainnet-shadow
Environment=TMPDIR=/var/lib/bloch-l2-mainnet-shadow/tmp
ExecStartPre=/usr/bin/python3 -u /opt/bloch/l2-mainnet-shadow/sequencer_mainnet.py check
ExecStart=/usr/bin/python3 -u /opt/bloch/l2-mainnet-shadow/sequencer_mainnet.py run
Restart=on-failure
RestartSec=30
# Exit 3 = divergence (identity, parent, anchor, genesis): wait for an operator.
RestartPreventExitStatus=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/bloch-l2-mainnet-shadow
ReadOnlyPaths=/etc/bloch-l2-mainnet-shadow /opt/bloch/l2-mainnet-shadow /var/lib/bloch-l2-mainnet-settler/work
# Defence in depth beside the own user: the settler's DA fee key, its passphrase (old, M-4 and runtime copy), the prover
# SSH key and the Docker socket (a read-only mount does not stop a socket connect). The shadow needs none of them.
InaccessiblePaths=-/run/docker.sock -/var/lib/bloch-l2-mainnet-da -/var/lib/bloch-l2-mainnet-settler/da.passphrase -/var/lib/bloch-l2-mainnet-settler/ssh -/etc/bloch-l2-mainnet-settler/da.passphrase -/run/bloch-l2-mainnet-settler
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Read-only getl2settlement on the three Genesis-4 mainnet nodes; nothing else.
IPAddressDeny=any
IPAddressAllow=localhost 80.240.16.185 199.247.22.8 45.77.67.251
LimitCORE=0
Nice=5
MemoryMax=4G
MemorySwapMax=0
CPUQuota=400%

[Install]
WantedBy=multi-user.target
