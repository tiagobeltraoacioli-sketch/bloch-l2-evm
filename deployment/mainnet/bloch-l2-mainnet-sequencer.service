[Unit]
Description=Bloch L2 mainnet (700770) block producer: one block per native source, deposits from the native inbox, wall-clock time (no proving, no submission)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bloch-l2-main
Group=bloch-l2-main
Environment=BLOCH_SEQUENCER_CONFIG=/etc/bloch-l2-mainnet-sequencer/config.json
Environment=HOME=/var/lib/bloch-l2-mainnet
Environment=TMPDIR=/var/lib/bloch-l2-mainnet/tmp
ExecStartPre=/usr/bin/python3 -u /opt/bloch/l2-mainnet-sequencer/sequencer_mainnet.py check
ExecStart=/usr/bin/python3 -u /opt/bloch/l2-mainnet-sequencer/sequencer_mainnet.py run
Restart=on-failure
RestartSec=30
# Exit 3 = divergence (identity, parent, anchor, genesis): wait for an operator.
RestartPreventExitStatus=3
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/bloch-l2-mainnet
ReadOnlyPaths=/etc/bloch-l2-mainnet-sequencer /opt/bloch/l2-mainnet-sequencer
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Read-only getl2settlement on the three Genesis-4 mainnet nodes; nothing else.
IPAddressDeny=any
IPAddressAllow=localhost 80.240.16.185 199.247.22.8 45.77.67.251
LimitCORE=0
Nice=5
MemoryMax=4G
MemorySwapMax=0
CPUQuota=400%

[Install]
WantedBy=multi-user.target
