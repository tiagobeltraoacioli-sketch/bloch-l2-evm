+/// Bloch host patch: process-wide wall-clock budget, in milliseconds, of one request that runs
+/// the EVM more than once (`eth_estimateGas`, `eth_createAccessList`); 0 means no budget. One EVM
+/// run cannot be interrupted: it is bounded by the gas cap ([`Call::call_gas_limit`]), which
+/// [`gas_within_cap`] applies to every gas-limit path. The budget is checked before each further
+/// run, so a request stops at most one capped run after it.
+static SIMULATION_TIME_LIMIT_MS: AtomicU64 = AtomicU64::new(0);
+
+/// Set the budget of [`SIMULATION_TIME_LIMIT_MS`] (`None`: no budget). Bloch host patch.
+pub fn set_simulation_time_limit(limit: Option<Duration>) {
+    let millis = limit.map_or(0, |limit| u64::try_from(limit.as_millis()).unwrap_or(u64::MAX).max(1));
+    SIMULATION_TIME_LIMIT_MS.store(millis, Ordering::Relaxed);
+}
+
+/// The budget set by [`set_simulation_time_limit`]. Bloch host patch.
+pub fn simulation_time_limit() -> Option<Duration> {
+    match SIMULATION_TIME_LIMIT_MS.load(Ordering::Relaxed) {
+        0 => None,
+        millis => Some(Duration::from_millis(millis)),
+    }
+}
+
+/// The deadline of one simulation request, from the moment it starts executing. Bloch host patch.
+#[derive(Clone, Copy, Debug)]
+pub struct SimulationDeadline {
+    started: Instant,
+    limit: Option<Duration>,
+}
+
+impl SimulationDeadline {
+    /// Start the clock with the current [`simulation_time_limit`].
+    pub fn start() -> Self {
+        Self { started: Instant::now(), limit: simulation_time_limit() }
+    }
+
+    /// [`EthApiError::ExecutionTimedOut`] once the budget is spent.
+    pub fn check(&self) -> Result<(), EthApiError> {
+        match self.limit {
+            Some(limit) if self.started.elapsed() >= limit => Err(EthApiError::ExecutionTimedOut(limit)),
+            _ => Ok(()),
+        }
+    }
+}
+
+/// `gas` capped to the RPC gas cap `cap` (0: no cap). Bloch host patch: upstream applies the cap
+/// to an explicit `eth_call` gas only, not to the caller-allowance fallback (which takes the block
+/// gas limit, itself open to a block override), nor to `eth_estimateGas` or
+/// `eth_createAccessList`.
+pub const fn gas_within_cap(gas: u64, cap: u64) -> u64 {
+    if cap != 0 && gas > cap {
+        cap
+    } else {
+        gas
+    }
+}
